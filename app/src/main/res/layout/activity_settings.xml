<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@android:drawable/ic_media_previous"
        app:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAutoScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_scroll" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchKeepAwake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/keep_screen_awake" />

            <TextView
                android:id="@+id/streamIntervalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/stream_interval"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/streamInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="33"
                android:valueTo="120"
                android:stepSize="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/model_storage"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/model_cache_explanation" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearModelCache"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/clear_imported_models" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
